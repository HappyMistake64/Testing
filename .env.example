# FADE Platform Configuration
# Copy to .env and adjust values as needed.

# Application
FADE_ENV=development
FADE_DEBUG=false
FADE_HOST=127.0.0.1
FADE_PORT=8000

# Database
FADE_DATABASE_URL=sqlite+aiosqlite:///./var/fade.db

# Logging
FADE_LOG_LEVEL=INFO
FADE_LOG_FORMAT=json

# Project registry (comma-separated absolute paths; empty = allow any)
FADE_PROJECT_ALLOWED_ROOTS=

# Resource budgets (M9)
FADE_MAX_CONCURRENT_HEAVY_JOBS=1
FADE_MAX_CONCURRENT_LIGHT_JOBS=2
FADE_ARTIFACT_RETENTION_DAYS=30
FADE_MAX_ARTIFACT_STORAGE_MB=2048
FADE_BACKUP_RETENTION_COUNT=7

# Frontend (Vite dev proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000
